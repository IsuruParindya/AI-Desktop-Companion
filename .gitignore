# ==============================
# Python
# ==============================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# ==============================
# Node.js
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Hermes LSP environment
hermes/lsp/

# ==============================
# Environment / Secrets
# ==============================
.env
.env.*
!.env.example

hermes/auth.json
hermes/auth.lock

# ==============================
# Runtime / Temporary Data
# ==============================
*.log
logs/
sessions/
cron/

hermes/.hermes_history
hermes/logs/
hermes/sessions/
hermes/cron/

# Hermes databases
hermes/*.db
hermes/*.db-*

# Hermes generated caches
hermes/*cache*

# ==============================
# Loona Generated Data
# ==============================
hermes/plugins/loona-tools/tools/files/.file_index.json

# ==============================
# Operating System
# ==============================
.DS_Store
Thumbs.db

# ==============================
# VS Code
# ==============================
.vscode/

# ==============================
# Hermes Source
# ==============================
# Hermes is included as a dependency but its upstream source
# is not committed to the Loona repository.
hermes/hermes-agent/
# ==============================
# Hermes Local Generated State
# ==============================
hermes/skills/.curator_state
hermes/skills/.curator_backups/
hermes/skills/.usage.json
hermes/skills/.usage.json.lock
hermes/pastes/

# ==============================
# Loona Generated Voice Tests
# ==============================
voice/*.mp3
voice/*.wav
# ==============================
# Loona Persistent Memory
# ==============================
hermes/memories/USER.md
hermes/memories/MEMORY.md
hermes/memories/*.lock
